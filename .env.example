# ---------- Application ----------
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
PUBLIC_FORM_ENABLED=false

# ---------- Supabase ----------
# Copy these from Supabase > Project Settings > API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Preferred current Supabase keys (Publishable key is public; Secret key is server-only)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_REAL_KEY
SUPABASE_SECRET_KEY=sb_secret_REPLACE_WITH_REAL_KEY
# Legacy alternatives, only if the project still uses them:
# SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY

# ---------- Employee funnel owner ----------
# Do not invent these. Get the approved values from Alpha Auron.
ASSIGNED_EMPLOYEE_NAME=Employee
ASSIGNED_EMPLOYEE_ID=REPLACE_WITH_COMPANY_EMPLOYEE_ID
ASSIGNED_EMPLOYEE_DESIGNATION=Talent Forge Associate
ASSIGNED_EMPLOYEE_USER_ID=REPLACE_WITH_SUPABASE_AUTH_USER_UUID
EMPLOYEE_EMAIL=REPLACE_WITH_VERIFIED_COMPANY_EMAIL
EMPLOYEE_PHONE=
EMPLOYEE_WHATSAPP=

# ---------- Company / emails ----------
EXECUTIVE_EMAIL=santhan@alphaauron.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Talent Forge <noreply@YOUR-VERIFIED-DOMAIN.com>

# ---------- Membership information ----------
# Official reference page. Reconfirm all plans and legal wording with the company before launch.
OFFICIAL_MEMBERSHIP_URL=https://alphaauron.com/talent-forge
PRIVACY_POLICY_URL=https://YOUR-APPROVED-PRIVACY-POLICY-URL

# ---------- Excel synchronisation ----------
# Local development default. On Render, attach a Persistent Disk mounted at /var/data
# and change this to /var/data/Talent_Forge_Membership_Leads.xlsx.
EXCEL_OUTPUT_PATH=./storage/Talent_Forge_Membership_Leads.xlsx
EXCEL_SYNC_ENABLED=true

# ---------- Optional ----------
# Set to true only when the company has approved live data collection and all required values above.
